<Window x:Class="PR_16_2_2var.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR_16_2_2var"
        mc:Ignorable="d"
        Title="Студенты" Height="450" Width="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Label>Специальность:</Label>
            <TextBox x:Name="txtspec" Margin="5"/>

            <Label>Предмет:</Label>
            <TextBox x:Name="txtsubject" Margin="5"/>

            <Label>Оценка (1-5):</Label>
            <TextBox x:Name="txtgrade" Margin="5"/>

            <Button x:Name="ButtonAdd" Content="Добавить предмет" Click="ButtonAdd_Click" Margin="5" Padding="5"/>
        </StackPanel>

        <DataGrid x:Name="dgSubjects" Grid.Row="2" Margin="5" AutoGenerateColumns="True"
                  CanUserAddRows="True" CanUserDeleteRows="True"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button x:Name="buttonSave" Content="Сохранить в CSV" Click="buttonSave_Click" Width="120" Margin="5"/>
            <Button x:Name="buttonLoad" Content="Загрузить из CSV" Click="buttonLoad_Click" Width="120" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
